  "policy": {
    "purpose": "Offline Spark Kafka classpath only; no arbitrary Maven resolution or executable download hooks.",
    "scopes": "Include nonoptional compile/runtime dependencies; Spark provided dependencies come from the pinned PySpark distribution. Ignore test dependencies and optional cglib/asm-util.",
    "mediation": "Use Spark 3.5.9 parent dependencyManagement: snappy 1.1.10.5, slf4j-api 2.0.7, lz4-java 1.8.0; kafka-clients zstd-jni is excluded by both Spark connector edges; preserve bundled zstd-jni 1.5.5-4.",
    "integrity": "Kafka publishes SHA-512. The Spark and commons-pool2 files had no SHA-512/SHA-256 sidecars (HTTP 404); their SHA-1 sidecars were verified and the downloaded bytes additionally pinned with actual SHA-256/SHA-512. SHA-1 is not represented as strong publisher authentication. No signatures were verified.",
    "classpath": "Only the four listed extra JARs; no duplicate bundled JARs, test JARs or optional dependencies."
  },
